// break stops the enclosing loop immediately.
int sum = 0;
for (int i = 0; i < 10; i += 1) {
    if (i == 4) { break; }
    sum += i;
}
printf("sum after break=%d\n", sum);  // 0+1+2+3 = 6

// continue skips rest of iteration but loop resumes.
int total = 0;
for (int i = 0; i < 6; i += 1) {
    if (i % 2 == 0) { continue; }
    total += i;
}
printf("odd sum=%d\n", total);  // 1+3+5 = 9

// while with break.
int x = 0;
while (1) {
    x += 1;
    if (x >= 5) { break; }
}
printf("x=%d\n", x);  // 5

// do-while with continue — still iterates normally to condition.
int dc = 0;
int kept = 0;
do {
    dc += 1;
    if (dc == 2) { continue; }
    kept += 1;
} while (dc < 4);
printf("dc=%d kept=%d\n", dc, kept);  // dc=4, kept=3 (1,3,4)

// nested: break only breaks innermost.
int ocount = 0;
for (int i = 0; i < 3; i += 1) {
    for (int j = 0; j < 3; j += 1) {
        if (j == 1) { break; }
        ocount += 1;
    }
}
printf("ocount=%d\n", ocount);  // 3 (one iter each of i)

exit(0);