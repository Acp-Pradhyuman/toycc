// Exercise deeply nested ternaries, both in the then-branch and the
// else-branch, with and without explicit parentheses. All conditions
// are compile-time-known so every branch resolves exactly.

int y = 2;

// Nested in else (user's original case).
int z1 = y>2 ? 1 : (y<2 ? 3 : 4);        // y==2 → 4
printf("z1 = %d\n", z1);

// Nested in then-branch.
int z2 = y>=0 ? (y==0 ? 10 : 20) : 30;   // y==2 → 20
printf("z2 = %d\n", z2);

// Three levels deep.
int n = 7;
int z3 = n<0 ? -1 : n==0 ? 0 : n<5 ? 1 : n<10 ? 2 : 3;  // n=7 → 2
printf("z3 = %d\n", z3);

// Ternary as argument to another expression.
int z4 = (y>1 ? 100 : 200) + 5;          // 105
printf("z4 = %d\n", z4);

// Chained ternary inside parentheses inside arithmetic.
int z5 = 2 * (y==2 ? 3 : 7) - 1;         // 5
printf("z5 = %d\n", z5);

// Ternary whose branches are themselves complex expressions.
int a = 3;
int b = 4;
int z6 = a < b ? b - a : a - b;          // 1
printf("z6 = %d\n", z6);

// sum to verify stable evaluation.
int total = z1 + z2 + z3 + z4 + z5 + z6; // 4+20+2+105+5+1 = 137
printf("total = %d\n", total);
exit(total);
