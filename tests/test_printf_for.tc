// Simple for.
for (int i = 0; i < 3; i += 1) {
    printf("for i=%d\n", i);
}

// Nested for.
for (int r = 0; r < 2; r += 1) {
    for (int c = 0; c < 2; c += 1) {
        printf("cell (%d,%d)\n", r, c);
    }
}

// For with if inside — only active branch prints.
for (int n = 0; n < 4; n += 1) {
    if (n == 2) {
        printf("hit 2\n");
    } else {
        printf("n=%d\n", n);
    }
}

exit(0);