// Classic recursive factorial and fibonacci.
int fact(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

printf("fact(6)=%d\n", fact(6));   // 720
printf("fib(10)=%d\n", fib(10));   // 55
exit(fib(10));                     // 55
