// Exercises switch with a complex case body: nested block, local
// declaration, for loop, and nested if/else. Confirms that each case
// body goes through the full parse_statement dispatch (not a
// specialized/limited one).
//
// Expected output (x=2 matches case 2):
//   Case 2
//   0 is even
//   1 is odd
//   2 is even
int x = 2;

switch (x) {
    case 1:
        printf("Case 1\n");
        break;

    case 2: {
        int i;
        printf("Case 2\n");
        for (i = 0; i < 3; i += 1) {
            if (i % 2 == 0) {
                printf("%d is even\n", i);
            } else {
                printf("%d is odd\n", i);
            }
        }
        break;
    }

    default:
        printf("Default case\n");
}
exit(0);
